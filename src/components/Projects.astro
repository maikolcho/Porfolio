---
import { projects } from '../data/site';
---

<section id="proyectos" class="section">
	<div class="container">
		<h2 class="section-title reveal">{projects.title}</h2>
		<div class="grid">
			{projects.items.map((p, i) => (
				<article class={`card reveal${p.images?.length ? " featured" : ""}`} style={`transition-delay:${i * 100}ms`}>
					{p.images && p.images.length > 0 && (
						<div class="shots">
							{p.images.map((img) => (
								<img src={img.src} alt={img.alt} width="540" height="1174" loading="lazy" />
							))}
						</div>
					)}
					<div class="body">
					<h3>{p.name}</h3>
					<p>{p.description}</p>
					<ul class="tags">
						{p.tags.map((t) => <li>{t}</li>)}
					</ul>
					<div class="links">
						{p.code && <a href={p.code} target="_blank" rel="noopener noreferrer">{projects.labels.code} ↗</a>}
						{p.demo && <a href={p.demo} target="_blank" rel="noopener noreferrer">{projects.labels.demo} ↗</a>}
					</div>
					</div>
	{p.gallery && p.gallery.length > 0 && (
						<div class="wide">
							<div class="wide-row">
								{p.gallery.map((img) => (
									<img src={img.src} alt={img.alt} width="1000" loading="lazy" />
								))}
							</div>
							{p.caption && <p class="caption">{p.caption}</p>}
						</div>
					)}
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(6, minmax(0, 1fr)); }
	.card { grid-column: span 3; min-width: 0; }
	@media (max-width: 760px) {
		.grid { grid-template-columns: minmax(0, 1fr); }
		.card { grid-column: 1 / -1; }
	}
	.card {
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 1.75rem;
		transition: border-color 0.25s, box-shadow 0.25s, transform 0.7s ease, opacity 0.7s ease;
	}
	.card:hover { border-color: var(--accent); box-shadow: 0 8px 30px rgba(34, 224, 122, 0.08); }
	.body { display: flex; flex-direction: column; flex: 1; }
	.featured {
		grid-column: 1 / -1;
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
		gap: clamp(1.5rem, 4vw, 3rem);
	}
	.featured .shots { margin: 0; padding: 0.25rem; flex: 0 0 auto; max-width: 100%; }
	.featured .shots img { width: 150px; }
	.featured h3 { font-size: 1.5rem; }
	.featured p { flex: 0 1 auto; margin-bottom: 1.25rem; max-width: 60ch; }
	@media (max-width: 900px) {
		.featured { flex-direction: column; flex-wrap: nowrap; align-items: stretch; }
		.featured .shots { overflow-x: auto; }
		.featured .shots img { width: min(46%, 150px); }
		.featured .shots img:only-child { width: min(72%, 250px); margin-inline: auto; }
	}
	.wide { flex: 1 1 100%; min-width: 0; margin-top: 0.5rem; }
	.wide-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.9rem; }
	.wide-row img { width: 100%; height: auto; border-radius: 8px; border: 1px solid var(--border); align-self: start; }
	.caption { font-family: var(--mono); font-size: 0.78rem; color: var(--muted); margin: 0.9rem 0 0; flex: none; }
	@media (max-width: 900px) {
		.wide-row { display: flex; gap: 0.75rem; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 0.5rem; }
		.wide-row img { flex: 0 0 88%; width: 88%; scroll-snap-align: start; }
	}
	.shots {
		display: flex;
		gap: 0.75rem;
		margin: -0.25rem -0.25rem 1.25rem;
		padding: 0.25rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
	}
	.shots img {
		flex: 0 0 auto;
		width: min(46%, 170px);
		height: auto;
		aspect-ratio: 540 / 1174;
		object-fit: cover;
		border-radius: 18px;
		border: 3px solid #1b2a23;
		scroll-snap-align: start;
	}
	h3 { font-size: 1.25rem; color: #fff; margin-bottom: 0.75rem; }
	p { color: var(--muted); flex: 1; }
	.tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; }
	.tags li {
		font-family: var(--mono);
		font-size: 0.75rem;
		color: var(--accent);
		background: var(--accent-dim);
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
	}
	.links { display: flex; gap: 1.25rem; font-family: var(--mono); font-size: 0.9rem; }
	.links a { display: inline-block; padding: 0.6rem 0; }
	.links a:hover { text-decoration: underline; }
</style>
